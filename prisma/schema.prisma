generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) standard models, extended with our own quiz fields.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Only set for email/password accounts. Null for Google-only accounts.
  password      String?

  // --- Quiz-specific fields (mirrors the old CustomUser model) ---
  points        Int       @default(0)
  played        Boolean   @default(false)
  year          String? // "1cp" | "2cp" | "1cs" | "2cs" | "3cs" | "other"
  flagged       Boolean   @default(false) // anti-cheat flag (was "fa9o")
  isAdmin       Boolean   @default(false)

  accounts    Account[]
  sessions    Session[]
  quizAttempt QuizAttempt?
  codeRedemptions CodeRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Single-row table holding the live event status. Read constantly (polled
// by waiting clients), written rarely (an admin flips it). Always accessed
// via lib/game-state.js, which pins the row to id = 1.
// ---------------------------------------------------------------------------

model GameState {
  id        Int      @id @default(1)
  // "not_started" | "open" | "ended"
  status    String   @default("not_started")
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Quiz content and server-side attempt tracking.
// The correct answer NEVER gets serialized to the client directly -
// only through the validated /api/quiz/submit route.
// ---------------------------------------------------------------------------

model Question {
  id            Int     @id @default(autoincrement())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String // "A" | "B" | "C" | "D"
  active        Boolean @default(true)

  // Which year this question belongs to: "1cp" | "2cp" | "1cs" | "2cs" | "3cs",
  // or "all" for a shared question served to every year.
  year          String  @default("all")

  @@index([year])
}

model QuizAttempt {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON-encoded array of Question ids, in the shuffled order shown to this user.
  // Storing this server-side means the submit route trusts nothing from the client
  // about which question is which - it re-derives everything from this + the DB.
  questionOrder String

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?
  score       Int?

  // JSON-encoded snapshot of the answers actually submitted, kept for auditing/disputes.
  answers String?
}

// ---------------------------------------------------------------------------
// Bonus codes: a flat list of admin-defined codes, each redeemable once per
// user for a fixed number of points. There's no in-app challenge attached
// to these anymore - they're earned on other platforms/events entirely
// (Instagram, physical scavenger hunts, whatever) and just typed in here.
// ---------------------------------------------------------------------------

model BonusCode {
  id     Int    @id @default(autoincrement())
  code   String @unique
  points Int    @default(20)
  // Optional admin-facing note, e.g. "Instagram story challenge" - never
  // shown to the person redeeming, just for your own bookkeeping in /admin.
  label  String?
  active Boolean @default(true)

  redemptions CodeRedemption[]

  createdAt DateTime @default(now())
}

// Records that a given USER has redeemed a given code. Since a code can be
// handed out to many people (it's not minted per person), "already
// redeemed" is scoped per user, not global - many different people can
// each redeem the same code once, but nobody can redeem it twice.
model CodeRedemption {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bonusCodeId Int
  bonusCode   BonusCode @relation(fields: [bonusCodeId], references: [id])
  redeemedAt  DateTime  @default(now())

  @@unique([userId, bonusCodeId])
}
