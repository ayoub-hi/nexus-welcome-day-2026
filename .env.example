# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: <your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Quiz config ---
QUIZ_DURATION_SECONDS=213 # 3:33, same as the original frontend
QUIZ_POINTS_PER_CORRECT_ANSWER=10

# Event status now lives in the database (GameState table), not an env var -
# it defaults to "not_started" and is controlled from /admin by an admin
# user. See "Granting admin access" in the README to create your first one.

# --- App ---
# Used for absolute callback URLs in some environments (optional in dev)
NEXTAUTH_URL="http://localhost:3000"

# Frontend and backend are now one app (same origin), so this is mostly a
# no-op / future-proofing in case anything ever calls the API cross-origin.
ALLOWED_ORIGINS="http://localhost:3000"
